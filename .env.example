# Copier en .env.local et renseigner au minimum DATABASE_URL.
#
#   cp .env.example .env.local
#
# Next lit .env.local puis .env. Les scripts (scripts/*.mts) suivent la même convention.
# Exception : drizzle.config.ts ne charge PAS dotenv — `npm run db:migrer` a donc besoin
# que DATABASE_URL soit présente dans l'environnement du shell :
#
#   export DATABASE_URL="postgresql://..." && npm run db:migrer

# --- Base de données (obligatoire) ---
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/backoffice

# --- URL publique de l'application ---
# Sert à construire les liens d'accès envoyés aux lauréats.
APP_URL=http://localhost:3000

# --- Stockage des pièces jointes ---
# Hors de public/ : ces fichiers portent des pièces d'identité et des états financiers.
# Défaut si absent : .stockage
STOCKAGE_DIR=.stockage

# --- Courriel ---
# Sans SMTP_HOST, aucun courriel n'est envoyé : le lien d'accès s'affiche dans la console.
# C'est le comportement attendu en développement.
MAIL_FROM=no-reply@exemple.ci
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=

# --- Hébergement des images (couvertures d'offres) ---
# Facultatif. Sans ces trois variables, le champ de couverture n'est pas proposé et tout le
# reste fonctionne : une offre n'a pas besoin d'image.
#
# Le secret ne quitte JAMAIS le serveur : le fichier passe par l'action de serveur, qui signe
# l'envoi. Ne pas préfixer ces noms par NEXT_PUBLIC_, ce qui les publierait dans le navigateur.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
